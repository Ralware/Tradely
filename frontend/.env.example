# Client-side API origin. Leave empty to use the same-origin Vite proxy
# (recommended for development and for FastAPI serving the production build).
# For a separately hosted build, set the absolute FastAPI origin, e.g.
# VITE_API_BASE_URL=http://127.0.0.1:8000
# An absolute value requires CORS to be enabled on the FastAPI side.
VITE_API_BASE_URL=

# Development-only proxy target used by vite.config.ts (never sent to the browser).
VITE_DEV_BACKEND=http://127.0.0.1:8000
