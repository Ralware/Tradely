# Tradely is private and binds to localhost by default.
HOST=127.0.0.1
# Informational only: run.bat starts uvicorn with --port 8000.
PORT=8000
DATABASE_PATH=./data/tradely.sqlite3

# Market data: every request is served by the local TradingView bridge.
TRADINGVIEW_BRIDGE_URL=http://127.0.0.1:8010
TRADINGVIEW_BRIDGE_TIMEOUT_SECONDS=60
TRADINGVIEW_CANDLES_TIMEOUT_SECONDS=50
TRADINGVIEW_QUOTES_TIMEOUT_SECONDS=30
TRADINGVIEW_SEARCH_TIMEOUT_SECONDS=15
TRADINGVIEW_LIVE_SEARCH_ENABLED=true

# Optional TradingView account cookies for the bridge (leave empty for anonymous
# access). Anonymous data is delayed on many exchanges; NSE is typically 15
# minutes delayed.
TRADINGVIEW_SESSION=
TRADINGVIEW_SIGNATURE=
# TRADINGVIEW_BRIDGE_PORT=8010

# Request/cache behavior
MARKET_CACHE_SECONDS=300
QUOTE_CRYPTO_TTL_SECONDS=10
QUOTE_GLOBAL_TTL_SECONDS=300
QUOTE_INDIA_TTL_SECONDS=600

# Risk defaults (estimates, not investment advice)
DEFAULT_ACCOUNT_CURRENCY=INR
DEFAULT_RISK_FRACTION=0.005
MAX_RISK_FRACTION=0.02
