# Tradely is private and binds to localhost by default.
HOST=127.0.0.1
# Informational only: run.bat starts uvicorn with --port 8000.
PORT=8000
DATABASE_PATH=./data/tradely.sqlite3

# Market data
TEJHQ_API_KEY=
COINGECKO_API_KEY=

# News / filings
SEC_USER_AGENT=Tradely Private Research contact@example.invalid
GDELT_ENABLED=true
YAHOO_NEWS_ENABLED=true

# Optional comma-separated RSS feed URLs. Only add feeds whose use terms permit your use.
RSS_FEED_URLS=

# Request/cache behavior
HTTP_TIMEOUT_SECONDS=15
NEWS_CACHE_SECONDS=900
MARKET_CACHE_SECONDS=300

# Risk defaults (estimates, not investment advice)
DEFAULT_ACCOUNT_CURRENCY=INR
DEFAULT_RISK_FRACTION=0.005
MAX_RISK_FRACTION=0.02
